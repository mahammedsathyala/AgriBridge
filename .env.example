# AgriBridge Environment Variables Specification
# Copy this file to .env and configure your production credentials.
# NOTE: Secrets are never exposed directly in client-side code.

# General
PORT=3000
NODE_ENV=development
APP_NAME=AgriBridge

# Satellite Remote Sensing (Copernicus / Sentinel-2 / Landsat-9)
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret_here
PLANET_API_KEY=your_planet_labs_key_here

# Weather Intelligence (India Meteorological Department / OpenWeatherMap)
IMD_WEATHER_API_KEY=your_imd_radar_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# IoT Sensor Telemetry (MQTT Broker / LoRaWAN Server)
MQTT_BROKER_URL=mqtts://broker.agribridge.org:8883
MQTT_CLIENT_ID=agri_web_client_gateway
MQTT_USERNAME=agri_sensor_user
MQTT_PASSWORD=your_mqtt_sensor_password_here

# AI Agro-Advisory & Computer Vision Disease Diagnosis
AI_MODEL_GATEWAY_URL=https://models.agribridge.brics-agrin.org/v1
CV_DISEASE_INFERENCE_ENDPOINT=https://models.agribridge.brics-agrin.org/v1/vision/leaf-spot
AGRI_AI_API_KEY=your_agro_inference_token_here

# BRICS Agricultural Data Cooperation (CADS API Gateway)
BRICS_CADS_GATEWAY_URL=https://cads.brics-agrin.org/api/v1
BRICS_COUNTRY_CODE=IN
BRICS_ADAPTER_AUTH_TOKEN=your_brics_mutual_tls_token_here
