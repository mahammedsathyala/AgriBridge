# AgriBridge Environment Variables
# Copy this file to .env and configure your production credentials.
# NOTE: Secrets are kept in backend environment variables and NEVER exposed to frontend JavaScript.

# --- Backend Server Configuration ---
APP_ENV=development
PORT=5000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=agrin-dev-secret-key-change-in-production

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,https://mahammedsathyala.github.io

# --- Weather & Remote Sensing ---
WEATHER_API_KEY=
SENTINEL_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# --- Anthropic Claude LLM Vernacular Localization ---
ANTHROPIC_API_KEY=

# --- ESP32 IoT MQTT Broker Telemetry ---
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC=agrin/sensors/soil

# --- Database ---
DATABASE_URL=sqlite:///agrin.db
